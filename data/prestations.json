{
  "requestTypes": {
    "spectra_acquisition": {
      "label": "Prise de spectres",
      "definition": "Mesures NIRS/SPIR ou MIR avec un instrument du plateau.",
      "example": "Exemple : réserver un MicroNIR ou envoyer un lot d'échantillons.",
      "pricingHint": "Estimation possible",
      "fields": [
        {
          "id": "serviceMode",
          "step": 2,
          "type": "radio",
          "label": "Mode de réalisation",
          "default": "self_service",
          "options": [
            {
              "value": "self_service",
              "label": "Utilisation autonome nominative"
            },
            {
              "value": "assisted",
              "label": "Utilisation accompagnée"
            },
            {
              "value": "full_service",
              "label": "Prestation complète par le plateau"
            }
          ],
          "section": "instrument_mode"
        },
        {
          "id": "instrument",
          "step": 2,
          "type": "select",
          "label": "Spectromêtre",
          "source": "instruments",
          "default": "viavi_micronir",
          "section": "instrument_mode"
        },
        {
          "id": "measurementLocation",
          "step": 2,
          "type": "radio",
          "label": "Lieu de réalisation pour ASD LabSpec",
          "default": "platform",
          "visibleWhen": {
            "field": "instrument",
            "equals": "asd_labspec"
          },
          "options": [
            {
              "value": "platform",
              "label": "Sur le plateau"
            },
            {
              "value": "field",
              "label": "Sur le terrain"
            }
          ],
          "section": "instrument_mode"
        },
        {
          "id": "hours",
          "step": 2,
          "type": "number",
          "label": "Nombre d'heures réservées",
          "min": 0.5,
          "max": 200,
          "stepValue": 0.5,
          "default": 2,
          "visibleWhen": {
            "any": [
              {
                "field": "serviceMode",
                "equals": "assisted"
              },
              {
                "all": [
                  {
                    "field": "serviceMode",
                    "equals": "self_service"
                  },
                  {
                    "field": "instrument",
                    "in": [
                      "bruker_tango",
                      "mir_perkin_elmer"
                    ]
                  }
                ]
              }
            ]
          },
          "section": "volume"
        },
        {
          "id": "reservedDays",
          "step": 2,
          "type": "number",
          "label": "Nombre de journées réservées",
          "min": 1,
          "max": 30,
          "stepValue": 1,
          "integer": true,
          "default": 1,
          "visibleWhen": {
            "all": [
              {
                "field": "serviceMode",
                "equals": "self_service"
              },
              {
                "field": "instrument",
                "in": [
                  "viavi_micronir",
                  "asd_labspec"
                ]
              }
            ]
          },
          "section": "volume"
        },
        {
          "id": "samples",
          "step": 2,
          "type": "number",
          "label": "Nombre d'échantillons",
          "min": 1,
          "max": 10000,
          "stepValue": 1,
          "default": 20,
          "integer": true,
          "visibleWhen": {
            "field": "serviceMode",
            "equals": "full_service"
          },
          "section": "volume"
        },
        {
          "id": "replicates",
          "step": 2,
          "type": "number",
          "label": "Répétitions par échantillon",
          "min": 1,
          "max": 20,
          "stepValue": 1,
          "default": 1,
          "integer": true,
          "visibleWhen": {
            "field": "serviceMode",
            "equals": "full_service"
          },
          "section": "volume"
        },
        {
          "id": "sampleReady",
          "step": 2,
          "type": "checkbox",
          "label": "Échantillons prêts à mesurer",
          "default": true,
          "visibleWhen": {
            "field": "serviceMode",
            "equals": "full_service"
          },
          "section": "available_data"
        },
        {
          "id": "preparationHours",
          "step": 2,
          "type": "number",
          "label": "Heures de préparation particulière",
          "min": 0,
          "max": 100,
          "stepValue": 0.5,
          "default": 0,
          "visibleWhen": {
            "field": "serviceMode",
            "in": [
              "assisted",
              "full_service"
            ]
          },
          "section": "options"
        },
        {
          "id": "simpleInterpretation",
          "step": 2,
          "type": "checkbox",
          "label": "Interprétation simple",
          "default": false,
          "visibleWhen": {
            "field": "serviceMode",
            "in": [
              "assisted",
              "full_service"
            ]
          },
          "section": "options"
        },
        {
          "id": "scientificInterpretationHours",
          "step": 2,
          "type": "number",
          "label": "Heures d'interprétation scientifique",
          "min": 0,
          "max": 100,
          "stepValue": 0.5,
          "default": 0,
          "visibleWhen": {
            "field": "serviceMode",
            "in": [
              "assisted",
              "full_service"
            ]
          },
          "section": "options"
        },
        {
          "id": "formalReport",
          "step": 2,
          "type": "checkbox",
          "label": "Rapport formalisé",
          "default": false,
          "visibleWhen": {
            "field": "serviceMode",
            "equals": "full_service"
          },
          "section": "options"
        },
        {
          "id": "fieldDays",
          "step": 2,
          "type": "number",
          "label": "Jours de mise à disposition terrain",
          "min": 1,
          "max": 30,
          "stepValue": 1,
          "default": 1,
          "integer": true,
          "visibleWhen": {
            "all": [
              {
                "field": "instrument",
                "equals": "asd_labspec"
              },
              {
                "field": "measurementLocation",
                "equals": "field"
              }
            ]
          },
          "section": "volume"
        },
        {
          "id": "fieldStaffHours",
          "step": 2,
          "type": "number",
          "label": "Temps personnel terrain",
          "min": 0,
          "max": 200,
          "stepValue": 0.5,
          "default": 0,
          "visibleWhen": {
            "all": [
              {
                "field": "instrument",
                "equals": "asd_labspec"
              },
              {
                "field": "measurementLocation",
                "equals": "field"
              }
            ]
          },
          "section": "volume"
        }
      ],
      "groupId": "measure",
      "order": 1,
      "allowMultiple": true,
      "shortDescription": "Mesurer des échantillons par NIRS/SPIR ou MIR."
    },
    "initial_training": {
